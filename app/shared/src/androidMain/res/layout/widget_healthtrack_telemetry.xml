<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_obsidian"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ==================== PAGE 0: SUMMARY / TELEMETRY ==================== -->
    <LinearLayout
        android:id="@+id/widget_page_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_calorie_ring"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="Calorie Telemetry Ring"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Protein -->
            <LinearLayout
                android:id="@+id/widget_macro_protein_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_protein_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="Protein"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/widget_protein_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="72"
                    android:progressDrawable="@drawable/progress_macro_protein" />

                <TextView
                    android:id="@+id/widget_protein_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="104/135g"
                    android:textColor="#E2E8F0"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:id="@+id/widget_macro_carbs_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_carbs_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="Karb"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/widget_carbs_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="64"
                    android:progressDrawable="@drawable/progress_macro_carbs" />

                <TextView
                    android:id="@+id/widget_carbs_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="148/230g"
                    android:textColor="#E2E8F0"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:id="@+id/widget_macro_fat_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_fat_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="Yağ"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/widget_fat_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="67"
                    android:progressDrawable="@drawable/progress_macro_fat" />

                <TextView
                    android:id="@+id/widget_fat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="46/68g"
                    android:textColor="#E2E8F0"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hydration Bar + +250ml Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_water_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="💧 1500 / 2500 ml"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/widget_water_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="3dp"
                        android:max="100"
                        android:progress="60"
                        android:progressDrawable="@drawable/progress_water" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_btn_add_water"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_widget_pill_cyan"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="+250ml"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== PAGE 1: AI FOOD QUICK-ADD ==================== -->
    <LinearLayout
        android:id="@+id/widget_page_ai_food"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_ai_food_input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_input_dark"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp"
            android:text="Ne yedin? Örn: 2 yumurta, 1 dilim ekmek..."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_ai_food_cta_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_widget_btn_primary"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="✨ AI ile Hesapla &amp; Öğüne Ekle"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ai_food_kcal_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bugün: 1480 / 2150 kcal"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_ai_food_manual_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Manuel Ekle"
                android:textColor="#06D6A0"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== PAGE 2: WORKOUT QUICK-LOG ==================== -->
    <LinearLayout
        android:id="@+id/widget_page_workout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_workout_ai_input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_input_dark"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp"
            android:text="Spor yaz (AI hesaplar) • 🔥 360 kcal"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_workout_preset_run"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_orange"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="30dk Koşu\n-310 kcal"
                android:textColor="#FB923C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_workout_preset_gym"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_orange"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="45dk Fitness\n-260 kcal"
                android:textColor="#FB923C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_workout_preset_walk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_orange"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="30dk Yürüyüş\n-150 kcal"
                android:textColor="#FB923C"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== PAGE 3: WEIGHT STEPPER & SAVE ==================== -->
    <LinearLayout
        android:id="@+id/widget_page_weight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_weight_value_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="74.2 kg"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weight_target_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="Hedef: 71.0 kg"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_weight_minus_05"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_action"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="-0.5"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weight_minus_01"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_action"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="-0.1"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weight_plus_01"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_action"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="+0.1"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weight_plus_05"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_pill_action"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="+0.5"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weight_save_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_widget_btn_purple"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:text="✓ Kaydet"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== PERSISTENT 4-PAGE BOTTOM NAV BAR ==================== -->
    <LinearLayout
        android:id="@+id/widget_bottom_nav_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_nav_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_tab_active"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Özet"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nav_ai_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill_action"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="AI Öğün"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nav_workout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill_action"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Spor"
            android:textColor="#FB923C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nav_weight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill_action"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Kilo"
            android:textColor="#C084FC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
